# MariaDB — Passwörter MÜSSEN gesetzt werden (Compose bricht sonst ab), keine Defaults!
MARIADB_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_DATABASE=chessresults
MYSQL_USER=chessresults
MYSQL_PASSWORD=CHANGE_ME_strong_db_password

# Crawler-API-Schluessel — Pflicht (Compose bricht sonst ab). Derselbe Wert wie RookHubs CRAWLER_API_KEY;
# der Platzhalter zaehlt wie kein Schluessel (API antwortet mit 503). Erzeugen z. B.: openssl rand -hex 32
CRAWLER_API_KEY=change_me_crawler_api_key

# Gluetun VPN (AirVPN + WireGuard)
VPN_SERVICE_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=10.x.x.x/32
SERVER_COUNTRIES=Germany
FIREWALL_VPN_INPUT_PORTS=8080

# Elasticsearch + Kibana — nur mit Profil: docker compose --profile logging up --build
# Ports lauschen nur auf 127.0.0.1 (ES/Kibana laufen OHNE Anmeldung).
ES_PORT=9200
KIBANA_PORT=5601
# Log-Ziel des Crawlers; leer = nur Konsole. Mit Profil "logging": http://elasticsearch:9200
CRAWLER_ES_URL=
